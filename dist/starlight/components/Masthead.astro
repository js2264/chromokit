---
/**
 * chromokit: a landing page's title — the mark beside the name, the size of a
 * name on a cover. The page's own <h1> is kept for search and screen readers,
 * and hidden by the stylesheet on a page with `.cx-landing`.
 */
interface Props {
  src: string
  name: string
}
const { src, name } = Astro.props
---

<div class="cx-masthead" aria-hidden="true">
  <img src={src} alt="" width="64" height="64" /><span>{name}</span>
</div>
