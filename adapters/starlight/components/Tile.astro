---
/** chromokit: one tile — a glyph, a name and a line. */
import { Icon } from '@astrojs/starlight/components'

interface Props {
  href: string
  icon: Parameters<typeof Icon>[0]['name']
  title: string
}
const { href, icon, title } = Astro.props
---

<a class="cx-tile" href={href}>
  <span class="cx-glyph"><Icon name={icon} /></span>
  <strong>{title}</strong>
  <span class="cx-tile-text"><slot /></span>
</a>
